rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'yaswanthadithyareddy11@gmail.com' ||
        request.auth.token.email == 'yaswanthadithyareddy12@gmail.com' ||
        request.auth.token.email == 'yaswanthadithyareddy10@gmail.com'
      );
    }

    // Config documents (global announcements, grading weights, maintenance)
    // Only verified Admin can modify configuration; sync and deployment events allowed for automated release sync
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin() || docId in ['sync', 'deployment'];
    }

    // User profiles - allows real student roll numbers (6-16 alphanumeric) or authenticated owner/admin
    match /users/{userId} {
      allow read: if true;
      allow create, update: if userId.matches('^[0-9A-Za-z]{6,16}$') || (request.auth != null && (request.auth.uid == userId || isAdmin()));
      allow delete: if isAdmin();
    }

    // Feedback collection - public creation with size validation, update/delete strictly restricted to admin
    match /feedback/{fbId} {
      allow read: if true;
      allow create: if request.resource.data.message is string && 
                       request.resource.data.message.size() > 0 && 
                       request.resource.data.message.size() <= 2500;
      allow update, delete: if isAdmin();
    }

    // Verified student login logs - validated student ID pattern, update/delete strictly restricted to admin
    match /userLogins/{loginId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string && 
                       request.resource.data.studentId.matches('^[0-9A-Za-z]{6,16}$');
      allow update, delete: if isAdmin();
    }

    // Registered students summary - validated student ID, delete strictly restricted to admin
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if studentId.matches('^[0-9A-Za-z]{6,16}$');
      allow delete: if isAdmin();
    }

    // Analytics counters (daily visits, aggregate traffic) - strictly controlled keys, delete strictly restricted to admin
    match /analytics/{docId} {
      allow read: if true;
      allow create, update: if docId in ['logins', 'traffic'];
      allow delete: if isAdmin();
    }

    // Attendance session cache - Closed to prevent unauthenticated access or tampering
    match /attendanceCache/{cacheId} {
      allow read, write: if false;
    }

    // Deny all other access by default (Zero-Trust Principle)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
