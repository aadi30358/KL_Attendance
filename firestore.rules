rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'yaswanthadithyareddy11@gmail.com' ||
        request.auth.token.email == 'yaswanthadithyareddy12@gmail.com' ||
        request.auth.token.email == 'yaswanthadithyareddy10@gmail.com' ||
        request.auth.token.email == 'yaswanthadithya3130@gmail.com'
      );
    }

    // Config documents (global announcements, grading weights, maintenance)
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles - strict IDOR protection: only the authenticated owner can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Feedback collection - public creation with size validation, read/update/delete enabled for admin operations
    match /feedback/{fbId} {
      allow read: if true;
      allow create: if request.resource.data.message is string && 
                       request.resource.data.message.size() > 0 && 
                       request.resource.data.message.size() <= 2500;
      allow update, delete: if true;
    }

    // Verified student login logs - validated student ID pattern, public read for admin dashboard live tracking
    match /userLogins/{loginId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string && 
                       request.resource.data.studentId.matches('^[0-9]{8,12}$');
      allow update, delete: if true;
    }

    // Registered students summary - validated student ID, public read for admin users tab
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if studentId.matches('^[0-9]{8,12}$');
      allow delete: if true;
    }

    // Analytics counters (daily visits, aggregate traffic) - strictly controlled keys
    match /analytics/{docId} {
      allow read: if true;
      allow create, update: if docId in ['logins', 'traffic'];
      allow delete: if true;
    }

    // Attendance session cache - Closed to prevent unauthenticated access or tampering
    match /attendanceCache/{cacheId} {
      allow read, write: if false;
    }

    // Deny all other access by default (Zero-Trust Principle)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

