rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an authorized admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'yaswanthadithyareddy11@gmail.com' || 
         request.auth.token.email == 'yaswanthadithya3130@gmail.com');
    }

    // Feedback collection: Anyone can submit legitimate feedback, only admin can delete/manage
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['timestamp']) &&
                    (!('comment' in request.resource.data) || request.resource.data.comment is string) &&
                    (!('studentId' in request.resource.data) || request.resource.data.studentId.matches('^[0-9]{8,12}$'));
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // User Logins: Verified student logins can be recorded; only admins can delete/modify
    match /userLogins/{loginId} {
      allow create: if request.resource.data.studentId.matches('^[0-9]{8,12}$');
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Students Directory: Managed only by admins or verified student record creation
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if studentId.matches('^[0-9]{8,12}$');
      allow delete: if isAdmin();
    }

    // Analytics: Traffic and aggregated visitor stats
    match /analytics/{metricId} {
      allow read, write: if true;
    }

    // Site settings & controls
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
